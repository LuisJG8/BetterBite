VITE_TYPESENSE_HOST=localhost
VITE_TYPESENSE_PORT=8108
VITE_TYPESENSE_PROTOCOL=http
VITE_TYPESENSE_SEARCH_KEY=betterbite-local-search-key
TYPESENSE_ADMIN_KEY=betterbite-local-admin-key
# Optional for local food recognition. Use a server-side token with Inference Providers access.
# Native release builds read the process environment. Keep credentials out of distributable app bundles.
HF_TOKEN=

# HTTPS endpoint that accepts multipart `pages` images and returns a MenuAnalysis JSON response.
# For native builds add the exact service origin (for example https://menu.example.com)
# to connect-src in both app.security.csp and app.security.devCsp in src-tauri/tauri.conf.json.
# The service must allow requests from the app origin and accept them without redirects.
# Keep provider API keys on the server; never expose them through a VITE_ variable.
VITE_MENU_ANALYSIS_ENDPOINT=
